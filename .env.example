# Copy to .env; NEVER commit real credentials.
COMPOSE_PROJECT_NAME=tig-stack
TZ=Asia/Ho_Chi_Minh

# Empty or omitted: latest image, except InfluxDB (latest compatible 2.x).
# Pin exact tags for production. Do not use InfluxDB 3.x with this stack.
INFLUXDB_VERSION=
PROMETHEUS_VERSION=
GRAFANA_VERSION=
CADDY_VERSION=

# Private: 127.0.0.1; direct IPv4 access: 0.0.0.0 or a specific host IP.
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# Direct IP example: http://192.0.2.10:3000/ (replace IP and port).
GRAFANA_ROOT_URL=http://localhost:3000

# Keep private; use a VPN or trusted network for remote database access.
INFLUXDB_BIND_IP=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_HEX_TOKEN
INFLUXDB_ORG=monitoring
INFLUXDB_BUCKET=telegraf
INFLUXDB_RETENTION=30d

PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_CONFIG_BIND_IP=127.0.0.1
PROMETHEUS_CONFIG_PORT=9091
PROMETHEUS_CONFIG_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# For public HTTPS set PUBLIC_DOMAIN and GRAFANA_ROOT_URL=https://your-domain/
PUBLIC_DOMAIN=grafana.example.com
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
